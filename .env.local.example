# Mesa OS Lite — local environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# ── Supabase (Frankfurt region) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (S3-compatible) ───────────────────────────────────
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN domain in front of the bucket (e.g. https://images.example.com)
R2_PUBLIC_URL=

# ── App ─────────────────────────────────────────────────────────────
# Used for absolute URLs (QR codes, share links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000


