# Mesa OS Lite — canonical environment template.
#
# Copy to `.env.local` for local dev (`cp .env.example .env.local`) and fill in
# real values. In production, set these in Coolify → Application → Environment.
# NEVER commit a filled-in .env / .env.local / .env.production — only this
# placeholder template is tracked (.gitignore: `!.env.*example`).
#
# ── BUILD-TIME vs RUNTIME ───────────────────────────────────────────────────
#   NEXT_PUBLIC_*  → inlined into the client bundle at BUILD time. In Coolify
#                    these MUST be set as Build Args (also exposed at runtime).
#                    Treat every NEXT_PUBLIC_* value as PUBLIC — it ships to the
#                    browser.
#   everything else → RUNTIME-only server secrets. Never prefixed NEXT_PUBLIC_,
#                    never sent to the browser. Set these in Coolify's runtime
#                    Environment Variables, NOT the Build Args.
# ────────────────────────────────────────────────────────────────────────────

# ── App (PUBLIC, build-time) ────────────────────────────────────────────────
# Canonical absolute URL — QR codes, share links, OG tags. No trailing slash.
# Local: http://localhost:3000   Production: https://qaema.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase — Frankfurt region ─────────────────────────────────────────────
# PUBLIC (build-time): the project URL + anon key are safe to expose; RLS guards
# the data. Both must be present as Build Args so Next can inline them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY (runtime): the service-role key bypasses RLS. It is used only by
# API routes / server actions (tenant auth, analytics ingest, owner panel).
# If this ever reaches the browser, treat it as a full database compromise.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (S3-compatible) — SERVER-ONLY (runtime) ───────────────────
# R2_ENDPOINT:    https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL:  the public CDN domain in front of the bucket. Its hostname is
#                 auto-added to next.config images.remotePatterns at build time,
#                 so next/image can optimize product photos. Example:
#                 https://pub-xxxxxxxx.r2.dev  (or a custom domain).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mesa-os-lite
R2_PUBLIC_URL=
