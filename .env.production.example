# BIZIII Menu — production environment variables.
# Set these in Coolify → Application → Environment Variables (Build + Runtime).
# Never commit a filled-in .env.production.

# ── App ─────────────────────────────────────────────────────────────
# Public canonical URL. Used for QR codes, share links, OG tags. No trailing slash.
# Must match the domain the app is served from (and its TLS cert).
#
# ⚠️ BUILD-TIME. This is a NEXT_PUBLIC_* var: Next inlines it into the bundle at
# BUILD time, not at runtime. It MUST be set before the first build — setting it
# afterwards has no effect on an already-built bundle.
# If it is missing at build time, the code silently falls back to
# `http://localhost:3000` (app/admin/dashboard/design/page.tsx,
# app/api/admin/qr-pdf/route.ts) and every generated QR code points at localhost.
# Printed QR codes cannot be recalled — verify the generated link starts with
# https://menu.biziii.io before printing anything.
NEXT_PUBLIC_APP_URL=https://menu.biziii.io

# ── Supabase (Frankfurt region) ─────────────────────────────────────
# Public envs are inlined at BUILD time — they MUST be set as build args
# (Coolify's "Build Args" toggle is on by default for Nixpacks / Dockerfile).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Runtime-only secret. Never exposed to the browser — only used by server
# code (API routes, server actions). Keep this in the Runtime envs section
# of Coolify, not the Build Args.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (S3-compatible) ───────────────────────────────────
# Runtime-only. R2_ENDPOINT is the S3-compatible endpoint
# (https://<account-id>.r2.cloudflarestorage.com); R2_PUBLIC_URL is the
# public CDN domain that fronts the bucket.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mesa-os-lite
R2_PUBLIC_URL=
